# Copy to .env.local and fill in. Required by the prebuild data pipeline
# (npm run generate-data / find-subdomains); not needed for npm run quickbuild,
# which reuses the committed src/data/*.json.

# Notion integration (scripts/generate-data.ts via src/lib/notion)
NOTION_TOKEN=
NOTION_BLOG_DATABASE_ID=
NOTION_DESIGN_DATABASE_ID=
NOTION_TRAVEL_DATABASE_ID=
NOTION_WAYPOINTS_DATABASE_ID=

# Cloudflare DNS (scripts/find-subdomains.ts)
CF_ZONE_ID=
CF_API_TOKEN=
