{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "nextjs", "promise"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    ".next/**",
    ".vercel/**",
    "out/**",
    "build/**",
    "dist/**",
    "public/**",
    "src/data/**"
  ],
  "overrides": [
    {
      "files": ["scripts/**", "src/lib/notion/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
